# Copy this file to secrets.env and fill in real values.
# secrets.env is gitignored and never committed.
#
# Generate PASSWORD_HASH:
#   python3 set_password.py   (writes directly to backend/.env)
#   -- or manually --
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('base64'))"
#
# Generate JWT_SECRET (any long random string):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PASSWORD_HASH=
JWT_SECRET=
